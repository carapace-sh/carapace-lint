package values

import "carapace"

func values() carapace.Action {
	return carapace.ActionValues("a", "b")
}

func described() carapace.Action {
	return carapace.ActionValuesDescribed(
		"a", "description a",
		"b", "description b",
	)
}

func duplicateValues() carapace.Action {
	return carapace.ActionValues("a", "b") // want `duplicate completion entry "a"` `completion value "a" should be sorted before "b"`
}

func duplicateStyles() carapace.Action {
	return carapace.ActionStyles("red", "blue") // want `duplicate completion entry "red"` `completion value "blue" should be sorted before "red"`
}

func duplicatedPairs() carapace.Action {
	return carapace.ActionValues(
		"a", // want `duplicate completion entry "a"`
		"b", // want `duplicate completion entry "b"`
	)
}

func duplicatedInline() carapace.Action {
	return carapace.ActionValues("a", "b") // want `duplicate completion entry "a"` `duplicate completion entry "b"` `completion value "a" should be sorted before "b"`
}

func duplicateValuesDescribed() carapace.Action {
	return carapace.ActionValuesDescribed(
		"a", "description a",
		"b", "description b",
	)
}

func repeatedWithDifferentDescriptions() carapace.Action {
	return carapace.ActionValuesDescribed(
		"a", "description a",
		"a", "other description",
	)
}

func repeatedWithDifferentStyles() carapace.Action {
	return carapace.ActionStyledValuesDescribed(
		"a", "description a", "red",
		"a", "description a", "green",
	)
}

func duplicateStyledValuesDescribed() carapace.Action {
	return carapace.ActionStyledValuesDescribed(
		"a", "description a", "red",
	)
}

func emptyValues() carapace.Action {
	return carapace.ActionValues("", "")
}

func oddValuesDescribed() carapace.Action {
	return carapace.ActionValuesDescribed("b", "description b", "a") // want `carapace.ActionValuesDescribed expects value/description pairs, got 3 arguments`
}

func oddStyledValues() carapace.Action {
	return carapace.ActionStyledValues("a", "red", "b") // want `carapace.ActionStyledValues expects value/style pairs, got 3 arguments`
}

func oddStyledValuesDescribed() carapace.Action {
	return carapace.ActionStyledValuesDescribed("a", "description a", "red", "b") // want `carapace.ActionStyledValuesDescribed expects value/description/style triples, got 4 arguments`
}

func spread(values ...string) carapace.Action {
	return carapace.ActionValuesDescribed(values...)
}

func multipleValues() carapace.Action {
	return carapace.ActionValuesDescribed(pair())
}

func pair() (string, string) {
	return "a", "b"
}

type other struct{}

func (other) ActionValuesDescribed(values ...string) carapace.Action { return carapace.Action{} }

func notCarapace(o other) carapace.Action {
	return o.ActionValuesDescribed("a", "b", "c")
}

func partiallyDynamic(a string) carapace.Action {
	return carapace.ActionValuesDescribed(
		"a", "description a",
		a, "description a",
	)
}

func runtimeValues(a, b string) carapace.Action {
	return carapace.ActionValuesDescribed(a, b)
}

func unsortedValues() carapace.Action {
	return carapace.ActionValues(
		"a", // want `completion value "a" should be sorted before "b"`
		"b",
	)
}

func unsortedDescribed() carapace.Action {
	return carapace.ActionValuesDescribed(
		"a", "description a", // want `completion value "a" should be sorted before "c"`
		"b", "description b",
		"c", "description c",
	)
}

func unsortedStyled() carapace.Action {
	return carapace.ActionStyledValues(
		"a", "blue", // want `completion value "a" should be sorted before "b"`
		"b", "red",
	)
}

func unsortedInline() carapace.Action {
	return carapace.ActionValues("a", "b") // want `completion value "a" should be sorted before "b"`
}

func unsortedAroundDynamic(a string) carapace.Action {
	return carapace.ActionValuesDescribed(
		"c", "description c",
		a, "dynamic",
		"a", "description a",
	)
}

func unsortedRuns(dyn string) carapace.Action {
	return carapace.ActionValuesDescribed(
		"a", "description a",
		dyn, "dynamic",
		"y", "description y", // want `completion value "y" should be sorted before "z"`
		"z", "description z",
	)
}

func unsortedInlineCommented() carapace.Action {
	return carapace.ActionValues("b" /* x */, "a") // want `completion value "a" should be sorted before "b"`
}

func unsortedMixed() carapace.Action {
	return carapace.ActionValuesDescribed(
		"a", "description a",
		"b", "description b", "c", "description c", // want `completion value "b" should be sorted before "c"` `completion value "a" should be sorted before "b"`
	)
}

func unsortedComments() carapace.Action {
	return carapace.ActionValuesDescribed(
		// leading comment
		"a", "description a",
		"b", "description b", // want `completion value "a" should be sorted before "b"`
	)
}

func unsortedCase() carapace.Action {
	return carapace.ActionValues("B", "a") // want `completion value "B" should be sorted before "a"`
}

func unsortedRaw() carapace.Action {
	return carapace.ActionValues("a", `b`) // want `completion value "a" should be sorted before "b"`
}

func emptyValue() carapace.Action {
	return carapace.ActionValues("", "a", "b") // want `completion value "a" should be sorted before "b"`
}

func batched() carapace.Action {
	return carapace.Batch(
		carapace.ActionValues("off", "on"), // want `completion value "off" should be sorted before "on"`
		carapace.ActionValues("ftp", "http", "m3u8"), // want `completion value "ftp" should be sorted before "http"`
	)
}
